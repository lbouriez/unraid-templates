#!/command/with-contenv sh
# shellcheck shell=sh
# Copy bundled plugins from /opt/hermes-builtin/ into the volume-mounted
# /opt/hermes/plugins/ directory at container startup.
# The Docker volume at /opt/hermes/ would shadow these files otherwise.

set -eu

target_dir=/opt/hermes/plugins

if [ -d /opt/hermes-builtin/plugins ]; then
    echo "[copy-openmemory-plugins] Copying bundled plugins into volume..."
    mkdir -p "$target_dir"
    cp -a /opt/hermes-builtin/plugins/. "$target_dir"/
    chown -R hermes:hermes "$target_dir"
    echo "[copy-openmemory-plugins] Done."
else
    echo "[copy-openmemory-plugins] No bundled plugins to copy (cold start or build issue)."
fi
