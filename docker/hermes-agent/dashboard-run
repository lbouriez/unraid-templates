#!/command/with-contenv sh
# shellcheck shell=sh
# Dashboard service. Always declared so s6 has a supervised slot; if
# HERMES_DASHBOARD isn't truthy the run script exits cleanly and the
# companion finish script returns 125 (s6's "permanent failure, do
# not restart" marker), so s6-svstat reports the slot as down. See
# also docker/s6-rc.d/dashboard/finish.
#
# Overridden from the upstream image to honour HERMES_DASHBOARD_INSECURE=1
# by passing --insecure to the hermes dashboard CLI.
#
# Context: upstream gutted the HERMES_DASHBOARD_INSECURE env-var in the
# June 2026 auth hardening (made it a no-op / warning), but the --insecure
# CLI flag itself was not removed. The bundled auth-provider plugins
# (dashboard_auth/nous, dashboard_auth/basic) are not yet shipped in the
# upstream wheel, leaving no other way to bind the dashboard to a
# non-loopback address. For homelab / Tailscale-gated deployments where
# Tailscale itself is the auth layer, --insecure on 0.0.0.0 is the
# correct and intentional choice. Remove this override once upstream ships
# the provider plugins.

case "${HERMES_DASHBOARD:-}" in
    1|true|TRUE|True|yes|YES|Yes) ;;
    *)
        exit 0
        ;;
esac

export HOME=/opt/data
cd /opt/data
# shellcheck disable=SC1091
. /opt/hermes/.venv/bin/activate

dash_host="${HERMES_DASHBOARD_HOST:-0.0.0.0}"
dash_port="${HERMES_DASHBOARD_PORT:-9119}"

insecure_flag=""
case "${HERMES_DASHBOARD_INSECURE:-}" in
    1|true|TRUE|True|yes|YES|Yes)
        echo "[dashboard] HERMES_DASHBOARD_INSECURE=1: passing --insecure (auth gate bypassed)." >&2
        echo "[dashboard] Ensure access is restricted at the network level (Tailscale, VPN, firewall)." >&2
        insecure_flag="--insecure"
        ;;
esac

[ "$(id -u)" = 0 ] || exec hermes dashboard \
    --host "$dash_host" --port "$dash_port" --no-open $insecure_flag
exec s6-setuidgid hermes hermes dashboard \
    --host "$dash_host" --port "$dash_port" --no-open $insecure_flag
